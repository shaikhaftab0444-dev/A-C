@model IEnumerable<BrandsStore.Models.Product>

@{
    ViewData["Title"] = "Products - Admin Dashboard";
}

<style>
    :root {
        --ink: #0a0a0f;
        --ink-soft: #3a3a4a;
        --ink-muted: #7a7a8c;
        --surface: #ffffff;
        --surface-2: #f4f6f9;
        --accent: #e8365d;
        --blue: #0f2c59;
        --green: #00b074;
        --tr: all .25s ease;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .admin-wrapper {
        display: flex;
        min-height: 100vh;
        background: var(--surface-2);
        font-family: 'DM Sans', sans-serif;
    }

    /* LEFT SIDEBAR */
    .admin-sidebar {
        width: 260px;
        background: #ffffff;
        border-right: 1px solid rgba(0,0,0,0.06);
        display: flex;
        flex-direction: column;
        padding: 28px 24px;
        flex-shrink: 0;
    }

    .admin-sidebar-brand {
        font-family: 'Playfair Display', serif;
        font-weight: 900;
        font-size: 1.4rem;
        color: var(--ink);
        margin-bottom: 36px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .sidebar-menu {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .sidebar-item a {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 18px;
        color: #64748b;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        border-radius: 8px;
        transition: var(--tr);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .sidebar-item.active a, .sidebar-item a:hover {
        background: rgba(15, 44, 89, 0.06);
        color: var(--blue);
    }

    .sidebar-item a i {
        font-size: 15px;
        width: 20px;
    }

    /* RIGHT CONTENT AREA */
    .admin-main {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    /* TOP BAR */
    .admin-topbar {
        height: 75px;
        background: #ffffff;
        border-bottom: 1px solid rgba(0,0,0,0.06);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 36px;
    }

    .topbar-search {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #f1f5f9;
        border-radius: 8px;
        padding: 10px 18px;
        width: 340px;
    }

    .topbar-search i {
        color: #94a3b8;
        font-size: 14px;
    }

    .topbar-search input {
        border: none;
        background: transparent;
        outline: none;
        font-size: 13px;
        width: 100%;
        color: var(--ink);
    }

    .topbar-user {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 13px;
        font-weight: 700;
        color: var(--ink);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .topbar-user-icon {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
        font-size: 14px;
    }

    /* CONTENT BODY */
    .admin-content {
        padding: 36px;
    }

    .content-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
    }

    .content-header-l {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .content-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--ink);
        margin: 0;
    }

    .content-subtitle {
        font-size: 13px;
        color: var(--ink-muted);
    }

    .btn-create {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--green);
        color: #ffffff;
        border: none;
        border-radius: 4px;
        padding: 12px 24px;
        font-family: 'DM Sans', sans-serif;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        text-decoration: none;
        transition: var(--tr);
    }

    .btn-create:hover {
        background: #009662;
        color: #ffffff;
        transform: translateY(-1px);
    }

    /* TABLE STYLES */
    .admin-table-card {
        background: #ffffff;
        border-radius: 8px;
        border: 1px solid rgba(0,0,0,0.06);
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        overflow: hidden;
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }

    .admin-table th {
        background: #f8fafc;
        padding: 18px 20px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748b;
        border-bottom: 1px solid rgba(0,0,0,0.06);
        text-align: left;
        letter-spacing: 0.05em;
    }

    .admin-table td {
        padding: 18px 20px;
        font-size: 13px;
        color: #334155;
        border-bottom: 1px solid rgba(0,0,0,0.04);
        vertical-align: middle;
    }

    .prod-thumbnail {
        width: 44px;
        height: 44px;
        border-radius: 4px;
        object-fit: cover;
        border: 1px solid rgba(0,0,0,0.06);
        background: #f8fafc;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 12px;
        border-radius: 100px;
        font-size: 11px;
        font-weight: 700;
        background: #ecfdf5;
        color: #10b981;
    }

    .status-badge.inactive {
        background: #fef2f2;
        color: #ef4444;
    }

    .action-btn-group {
        display: flex;
        gap: 8px;
    }

    .admin-btn-edit {
        background: var(--blue);
        color: #ffffff;
        border: none;
        border-radius: 4px;
        padding: 8px 18px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        text-decoration: none;
        transition: var(--tr);
    }

    .admin-btn-edit:hover {
        background: #1e457e;
        color: #ffffff;
    }

    .admin-btn-delete {
        background: transparent;
        color: #ef4444;
        border: 1.5px solid #ef4444;
        border-radius: 4px;
        padding: 6px 16px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        transition: var(--tr);
        cursor: pointer;
    }

    .admin-btn-delete:hover {
        background: #fef2f2;
    }

    /* MODAL */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity .3s ease;
        z-index: 10000;
    }

    .modal-overlay.show {
        opacity: 1;
        pointer-events: auto;
    }

    .modal-box {
        background: #ffffff;
        border-radius: 8px;
        padding: 32px;
        width: 440px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.15);
        text-align: center;
    }

    .modal-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #fee2e2;
        color: #ef4444;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        margin: 0 auto 20px;
    }

    .modal-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 12px;
    }

    .modal-msg {
        font-size: 14px;
        color: var(--ink-soft);
        line-height: 1.5;
        margin-bottom: 24px;
    }

    .modal-btns {
        display: flex;
        gap: 12px;
    }

    .btn-modal-cancel {
        flex: 1;
        padding: 12px;
        border: 1.5px solid #e2e8f0;
        border-radius: 4px;
        background: #ffffff;
        font-size: 13px;
        font-weight: 700;
        color: var(--ink-soft);
        cursor: pointer;
    }

    .btn-modal-cancel:hover {
        background: #f8fafc;
    }

    .btn-modal-del {
        flex: 1;
        padding: 12px;
        background: #ef4444;
        color: #ffffff;
        border: none;
        border-radius: 4px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }

    .btn-modal-del:hover {
        background: #dc2626;
    }
</style>

<div class="admin-wrapper">

    <!-- LEFT SIDEBAR -->
    <div class="admin-sidebar">
        <a href="/Admin/Products" class="admin-sidebar-brand">
            <i class="fas fa-gem" style="color: var(--accent);"></i> AQSA COLLECTION
        </a>
        <ul class="sidebar-menu">
            <li class="sidebar-item">
                <a href="/Admin"><i class="fas fa-chart-line"></i> Dashboard</a>
            </li>
            <li class="sidebar-item active">
                <a href="/Admin/Products"><i class="fas fa-gem"></i> Products</a>
            </li>
            <li class="sidebar-item">
                <a href="#"><i class="fas fa-shopping-bag"></i> Orders</a>
            </li>
            <li class="sidebar-item">
                <a href="#"><i class="fas fa-users"></i> Customers</a>
            </li>
            <li class="sidebar-item">
                <a href="#"><i class="fas fa-cog"></i> Settings</a>
            </li>
        </ul>
    </div>

    <!-- RIGHT CONTENT AREA -->
    <div class="admin-main">
        
        <!-- TOPBAR -->
        <div class="admin-topbar">
            <div class="topbar-search">
                <i class="fas fa-search"></i>
                <input type="text" id="adminSearch" placeholder="Search product catalog..." />
            </div>
            <div class="topbar-user">
                <div class="topbar-user-icon"><i class="fas fa-user"></i></div>
                <span>Admin User</span>
            </div>
        </div>

        <!-- CONTENT BODY -->
        <div class="admin-content">
            
            <div class="content-header">
                <div class="content-header-l">
                    <h2 class="content-title">Products</h2>
                    <div class="content-subtitle">Fvtomanages from SQL Server</div>
                </div>
                <a asp-action="CreateProduct" class="btn-create">
                    <i class="fas fa-plus"></i> Add New Product
                </a>
            </div>

            <!-- TABLE CARD -->
            <div class="admin-table-card">
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Image</th>
                                <th>Product Name</th>
                                <th>Category</th>
                                <th>SKU</th>
                                <th>Price (INR)</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="adminProdBody">
                            @if (Model != null && Model.Any())
                            {
                                foreach (var p in Model)
                                {
                                    <tr data-name="@p.Name?.ToLower()" data-sku="@p.SKU?.ToLower()">
                                        <td><span style="font-weight:700; color:var(--ink-muted);">@p.ProductId</span></td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                                            {
                                                <img class="prod-thumbnail" src="@p.ImageUrl" alt="@p.Name"
                                                     onerror="this.src='https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?q=80&w=100';" />
                                            }
                                            else
                                            {
                                                <div class="prod-thumbnail" style="display:flex; align-items:center; justify-content:center; color:#94a3b8; font-size:16px;">
                                                    <i class="fas fa-image"></i>
                                                </div>
                                            }
                                        </td>
                                        <td><strong>@p.Name</strong></td>
                                        <td>@p.Category?.Name</td>
                                        <td><span style="font-family:monospace; font-size:12px; color:var(--ink-soft);">@p.SKU</span></td>
                                        <td><strong>₹@p.Price.ToString("N2")</strong></td>
                                        <td>@p.StockQuantity</td>
                                        <td>
                                            @if (p.IsActive)
                                            {
                                                <span class="status-badge">New</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge inactive">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="action-btn-group">
                                                <a asp-action="EditProduct" asp-route-id="@p.ProductId" class="admin-btn-edit">Edit</a>
                                                <button type="button" class="admin-btn-delete"
                                                        onclick="confirmDelete(@p.ProductId, '@p.Name?.Replace("'", "\\'")')">
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" style="text-align:center; padding: 40px; color:var(--ink-muted);">
                                        No products found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

    </div>

</div>

<!-- DELETE MODAL -->
<div class="modal-overlay" id="adminDelModal">
    <div class="modal-box">
        <div class="modal-icon"><i class="fas fa-trash"></i></div>
        <div class="modal-title">Delete Product?</div>
        <div class="modal-msg">You're about to permanently delete <strong id="adminDelName"></strong>. This action cannot be undone.</div>
        <div class="modal-btns">
            <button class="btn-modal-cancel" onclick="closeDelete()">Cancel</button>
            <form id="adminDelForm" method="post" style="flex:1;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-modal-del" style="width:100%;">
                    Delete
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id, name) {
            document.getElementById('adminDelName').textContent = name;
            document.getElementById('adminDelForm').action = '/Admin/DeleteProduct/' + id;
            document.getElementById('adminDelModal').classList.add('show');
        }
        function closeDelete() {
            document.getElementById('adminDelModal').classList.remove('show');
        }
        document.getElementById('adminDelModal').addEventListener('click', function(e) {
            if (e.target === this) closeDelete();
        });

        // Live local filter
        document.getElementById('adminSearch').addEventListener('input', function(e) {
            const query = e.target.value.toLowerCase().trim();
            const rows = document.querySelectorAll('#adminProdBody tr');
            rows.forEach(row => {
                const name = row.getAttribute('data-name') || '';
                const sku = row.getAttribute('data-sku') || '';
                if (name.includes(query) || sku.includes(query)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    </script>
}
