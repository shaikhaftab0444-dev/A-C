@model BrandsStore.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

<style>
    :root {
        --ink: #0a0a0f;
        --ink-soft: #3a3a4a;
        --ink-muted: #7a7a8c;
        --surface: #fff;
        --surface-2: #f4f4f8;
        --surface-3: #e6e6ee;
        --accent: #e8365d;
        --accent-dark: #c42548;
        --accent-glow: rgba(232,54,93,.09);
        --green: #00b074;
        --green-glow: rgba(0,176,116,.09);
        --radius-sm: 8px;
        --radius-md: 16px;
        --radius-lg: 22px;
        --tr: all .3s cubic-bezier(.4,0,.2,1);
    }

    .ep-page {
        font-family: 'DM Sans',sans-serif;
        background: var(--surface-2);
        min-height: 100vh;
        padding: 28px 28px 56px;
    }

    .ep-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }

    .ep-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--ink-muted);
    }

    .ep-breadcrumb a {
        color: var(--ink-muted);
        text-decoration: none;
        transition: var(--tr);
    }

    .ep-breadcrumb a:hover {
        color: var(--ink);
    }

    .ep-breadcrumb i {
        font-size: 9px;
    }

    .ep-breadcrumb span {
        color: var(--ink);
        font-weight: 600;
    }

    .ep-hero {
        position: relative;
        overflow: hidden;
        background: var(--ink);
        border-radius: var(--radius-lg);
        padding: 30px 40px;
        margin-bottom: 26px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }

    .ep-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 90% 50%,rgba(232,54,93,.16) 0%,transparent 50%);
    }

    .ep-hero-left {
        position: relative;
        z-index: 1;
    }

    .ep-hero-tag {
        font-size: 11px;
        font-weight: 700;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ep-hero-tag::before {
        content: '';
        width: 18px;
        height: 2px;
        background: var(--accent);
        border-radius: 1px;
    }

    .ep-hero-title {
        font-family: 'Playfair Display',serif;
        font-size: clamp(1.6rem,3vw,2.3rem);
        font-weight: 900;
        color: #fff;
        margin: 0 0 4px;
    }

    .ep-hero-title em {
        font-style: italic;
        color: var(--accent);
    }

    .ep-hero-sub {
        font-size: 13px;
        color: rgba(255,255,255,.45);
        margin: 0;
    }

    .ep-hero-right {
        position: relative;
        z-index: 1;
    }

    .ep-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.13);
        border-radius: 100px;
        padding: 10px 22px;
        color: rgba(255,255,255,.8);
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: var(--tr);
    }

    .ep-back-btn:hover {
        background: rgba(255,255,255,.14);
        color: #fff;
    }

    .fc {
        background: #fff;
        border-radius: var(--radius-lg);
        border: 1px solid var(--surface-3);
        max-width: 680px;
        margin: 0 auto;
        overflow: hidden;
    }

    .fc-head {
        padding: 18px 26px;
        border-bottom: 1px solid var(--surface-3);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .fc-ico {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
    }

    .fc-ico.red {
        background: var(--accent-glow);
        color: var(--accent);
    }

    .fc-title {
        font-family: 'Playfair Display',serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--ink);
        margin: 0;
    }

    .fc-sub {
        font-size: 11px;
        color: var(--ink-muted);
    }

    .fc-body {
        padding: 26px;
    }

    .fg {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 18px;
    }

    .fl {
        font-size: 11px;
        font-weight: 800;
        color: var(--ink);
        text-transform: uppercase;
        letter-spacing: .6px;
    }

    .fl .req {
        color: var(--accent);
        margin-left: 2px;
    }

    .fi, .ft {
        background: var(--surface-2);
        border: 1.5px solid var(--surface-3);
        border-radius: var(--radius-sm);
        padding: 11px 15px;
        font-family: 'DM Sans',sans-serif;
        font-size: 14px;
        color: var(--ink);
        outline: none;
        transition: var(--tr);
        width: 100%;
    }

    .fi:focus, .ft:focus {
        border-color: var(--accent);
        background: #fff;
        box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .ft {
        resize: vertical;
        min-height: 94px;
    }

    .toggle-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 13px 16px;
        background: var(--surface-2);
        border-radius: var(--radius-sm);
        border: 1.5px solid var(--surface-3);
        margin-bottom: 24px;
    }

    .toggle-row .form-check-input[role="switch"] {
        width: 3rem;
        height: 1.5rem;
        cursor: pointer;
    }

    .toggle-row .form-check-input:checked {
        background-color: var(--green);
        border-color: var(--green);
    }

    .toggle-info strong {
        font-size: 13px;
        font-weight: 700;
        color: var(--ink);
        display: block;
    }

    .toggle-info span {
        font-size: 11px;
        color: var(--ink-muted);
    }

    .action-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        color: var(--ink);
        border: 1.5px solid var(--surface-3);
        border-radius: 100px;
        padding: 12px 24px;
        font-family: 'DM Sans',sans-serif;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: var(--tr);
    }

    .btn-cancel:hover {
        background: var(--ink);
        color: #fff;
        border-color: var(--ink);
    }

    .btn-save {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 100px;
        padding: 13px 36px;
        font-family: 'DM Sans',sans-serif;
        font-size: 15px;
        font-weight: 800;
        cursor: pointer;
        transition: var(--tr);
    }

    .btn-save:hover {
        background: var(--accent-dark);
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(232,54,93,.3);
    }
</style>

<div class="ep-page">
    <div class="ep-topbar">
        <div class="ep-breadcrumb">
            <a asp-action="Index">Dashboard</a>
            <i class="fas fa-chevron-right"></i>
            <a asp-action="Categories">Categories</a>
            <i class="fas fa-chevron-right"></i>
            <span>Create Category</span>
        </div>
    </div>

    <div class="ep-hero">
        <div class="ep-hero-left">
            <div class="ep-hero-tag"><i class="fas fa-plus"></i> Admin Panel</div>
            <h1 class="ep-hero-title">Create <em>Category</em></h1>
            <p class="ep-hero-sub">Add a new category to organize your products.</p>
        </div>
        <div class="ep-hero-right">
            <a asp-action="Categories" class="ep-back-btn"><i class="fas fa-arrow-left"></i> Back to Categories</a>
        </div>
    </div>

    <form asp-action="CreateCategory" method="post">
        @Html.AntiForgeryToken()
        <div class="fc">
            <div class="fc-head">
                <div class="fc-ico red"><i class="fas fa-info-circle"></i></div>
                <div>
                    <div class="fc-title">Category Information</div>
                    <div class="fc-sub">Provide name, description and visibility status</div>
                </div>
            </div>
            <div class="fc-body">
                <div class="fg">
                    <label class="fl">Category Name<span class="req">*</span></label>
                    <input asp-for="Name" class="fi" placeholder="e.g. Necklaces, Rings, Accessories" required />
                    <span asp-validation-for="Name" class="text-danger" style="font-size:11px;"></span>
                </div>

                <div class="fg">
                    <label class="fl">Description</label>
                    <textarea asp-for="Description" class="ft" placeholder="Enter a brief description of this category"></textarea>
                    <span asp-validation-for="Description" class="text-danger" style="font-size:11px;"></span>
                </div>

                <div class="toggle-row">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="activeToggle" />
                    <div class="toggle-info">
                        <strong>Category Active</strong>
                        <span>When enabled, this category and its products are visible in the store</span>
                    </div>
                </div>

                <div class="action-bar">
                    <a asp-action="Categories" class="btn-cancel">Cancel</a>
                    <button type="submit" class="btn-save"><i class="fas fa-save"></i> Save Category</button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
