<div class="toast-container" id="toastContainer"></div>

<!-- ===== HERO — DYNAMIC OFFERS OR FALLBACK ===== -->
@if (hasOffers)
{
    <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="5500">
        <div class="carousel-inner">
            @for (int i = 0; i < heroOffers!.Count; i++)
            {
                var offer = heroOffers[i];
                string primaryUrl = string.IsNullOrEmpty(offer.PrimaryButtonUrl) ? "/Home/Products" : offer.PrimaryButtonUrl;
                string bgHex = (string.IsNullOrEmpty(offer.AccentColor) || offer.AccentColor.Equals("#e8365d", StringComparison.OrdinalIgnoreCase))
                ? "#f1ebdc"
                : offer.AccentColor;
                string displayImg = !string.IsNullOrEmpty(offer.ImageUrl)
                ? offer.ImageUrl
                : (!string.IsNullOrEmpty(offer.BackgroundImageUrl) ? offer.BackgroundImageUrl : "https://images.unsplash.com/photo-1543294001-f7cbfe92237e?q=80&w=1200");

                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <div class="luxury-hero" style="background: @bgHex;">
                        <div class="luxury-hero-img-wrap">
                            <img src="@displayImg" alt="@offer.Title" class="luxury-hero-img">
                        </div>
                        <div class="luxury-hero-left">
                            <div data-reveal>
                                <div class="hero-eyebrow"><span class="facet-dot"></span> Handset &middot; Certified &middot; Aqsa Edit</div>
                                <h1 class="hero-headline">
                                    @offer.Title<strong>@offer.Subtitle</strong>
                                </h1>
                                @if (!string.IsNullOrEmpty(offer.Description))
                                {
                                    <p class="hero-sub">@offer.Description</p>
                                }
                                <a href="@primaryUrl" class="btn-hero-primary">
                                    @(string.IsNullOrEmpty(offer.PrimaryButtonText) ? "Shop New Arrivals" : offer.PrimaryButtonText)
                                    <span class="arrow"><i class="fas fa-arrow-right" style="font-size:11px;"></i></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (heroOffers.Count > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <i class="fas fa-chevron-left" style="color:var(--ivory);font-size:14px;"></i>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <i class="fas fa-chevron-right" style="color:var(--ivory);font-size:14px;"></i>
            </button>
        }
    </div>
}
else
{
    <div class="luxury-hero">
        <div class="luxury-hero-img-wrap">
            <img src="https://images.unsplash.com/photo-1543294001-f7cbfe92237e?q=80&w=1200" alt="AQSA COLLECTION" class="luxury-hero-img">
        </div>
        <div class="luxury-hero-left">
            <div data-reveal>
                <div class="hero-eyebrow"><span class="facet-dot"></span> Handset &middot; Certified &middot; Aqsa Edit</div>
                <h1 class="hero-headline">Elegance in<strong>Every Detail.</strong></h1>
                <p class="hero-sub">Fine jewelry and accessories, cut and finished for everyday wear — sourced from verified craftspeople and delivered to your door.</p>
                <a asp-controller="Home" asp-action="Products" class="btn-hero-primary">
                    Shop New Arrivals <span class="arrow"><i class="fas fa-arrow-right" style="font-size:11px;"></i></span>
                </a>
            </div>
        </div>
    </div>
}

