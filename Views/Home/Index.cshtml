@model IEnumerable<BrandsStore.Models.Product>

@{
    ViewData["Title"] = "Home";
    var heroOffers = ViewBag.HeroOffers as List<BrandsStore.Models.Offer>;
    bool hasOffers = heroOffers != null && heroOffers.Any();
}

<style>
    :root {
        --ink: #12201b;
        --ink-soft: #3f4f47;
        --ink-muted: #7d8b83;
        --ivory: #faf6ee;
        --stone: #f1ebdc;
        --stone-2: #e6dcc7;
        --emerald: #1f4d3d;
        --emerald-deep: #0c2620;
        --emerald-glow: rgba(31,77,61,.14);
        --gold: #b6872f;
        --gold-light: #e8cd8a;
        --gold-glow: rgba(182,135,47,.18);
        --rose: #c98a7d;
        --green-ok: #2f7a52;
        --cut: 22px;
        --cut-sm: 12px;
        --transition: all .35s cubic-bezier(.4,0,.2,1);
        --shadow-sm: 0 2px 14px rgba(18,32,27,.06);
        --shadow-md: 0 10px 34px rgba(18,32,27,.10);
        --shadow-lg: 0 26px 60px rgba(18,32,27,.16);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Inter',sans-serif;
        color: var(--ink);
        background: var(--ivory);
        overflow-x: hidden;
    }

    .serif {
        font-family: 'Fraunces', serif;
    }

    /* facet-cut: signature angular gem-corner motif reused everywhere */
    .facet {
        clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut)));
    }

    .facet-sm {
        clip-path: polygon(0 0, calc(100% - var(--cut-sm)) 0, 100% var(--cut-sm), 100% 100%, var(--cut-sm) 100%, 0 calc(100% - var(--cut-sm)));
    }

    [data-reveal] {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity .85s cubic-bezier(.16,1,.3,1), transform .85s cubic-bezier(.16,1,.3,1);
    }

        [data-reveal].in-view {
            opacity: 1;
            transform: translateY(0);
        }

    [data-reveal="scale"] {
        transform: scale(.94);
    }

        [data-reveal="scale"].in-view {
            transform: scale(1);
        }

    @@media (prefers-reduced-motion: reduce) {
        [data-reveal] {
            opacity: 1 !important;
            transform: none !important;
        }
    }

    /* TOAST */
    .toast-container {
        position: fixed;
        top: 90px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .custom-toast {
        min-width: 300px;
        background: var(--ivory);
        box-shadow: var(--shadow-lg);
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        animation: toastIn .45s cubic-bezier(.16,1,.3,1) forwards;
        border-left: 3px solid var(--green-ok);
    }

        .custom-toast.error {
            border-left-color: #b3432f;
        }

    @@keyframes toastIn {
        from {
            transform: translateX(120%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    .toast-icon {
        font-size: 20px;
        color: var(--emerald);
    }

    .custom-toast.error .toast-icon {
        color: #b3432f;
    }

    .toast-message {
        flex: 1;
    }

        .toast-message strong {
            display: block;
            font-size: 13px;
            font-weight: 700;
            color: var(--ink);
            text-transform: uppercase;
            letter-spacing: .05em;
        }

        .toast-message p {
            font-size: 13px;
            color: var(--ink-muted);
        }

    .toast-close {
        background: none;
        border: none;
        font-size: 16px;
        color: var(--ink-muted);
        cursor: pointer;
    }

    /* ===== HERO ===== */
    .luxury-hero {
        position: relative;
        width: 100%;
        background: var(--stone);
        min-height: 580px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        overflow: hidden;
    }

    .luxury-hero-img-wrap {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        overflow: hidden;
    }

    .luxury-hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        filter: saturate(.92) brightness(.97);
        transition: transform 1.4s cubic-bezier(.16,1,.3,1);
    }

    .luxury-hero:hover .luxury-hero-img {
        transform: scale(1.04);
    }

    .luxury-hero-img-wrap::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(100deg, var(--stone) 0%, var(--stone) 34%, transparent 62%);
    }

    .luxury-hero-left {
        position: relative;
        width: 52%;
        z-index: 2;
        padding: 90px 100px;
        display: flex;
        align-items: center;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--emerald);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .28em;
        text-transform: uppercase;
        margin-bottom: 26px;
    }

        .hero-eyebrow .facet-dot {
            width: 7px;
            height: 7px;
            background: var(--gold);
            transform: rotate(45deg);
            display: inline-block;
        }

    .hero-headline {
        font-family: 'Fraunces', serif;
        font-optical-sizing: auto;
        font-size: clamp(2.4rem, 4.6vw, 3.6rem);
        font-weight: 400;
        line-height: 1.16;
        color: var(--ink);
        margin-bottom: 24px;
        letter-spacing: -.005em;
    }

        .hero-headline strong {
            font-weight: 600;
            display: block;
            color: var(--emerald-deep);
        }

    .hero-sub {
        font-size: 15px;
        color: var(--ink-soft);
        line-height: 1.75;
        max-width: 420px;
        margin-bottom: 34px;
    }

    .btn-hero-primary {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        background: var(--emerald);
        color: var(--ivory) !important;
        padding: 16px 30px;
        font-weight: 600;
        font-size: 13px;
        letter-spacing: .1em;
        text-transform: uppercase;
        text-decoration: none !important;
        transition: var(--transition);
        box-shadow: var(--shadow-md);
    }

        .btn-hero-primary:hover {
            background: var(--emerald-deep);
            transform: translateY(-3px);
            box-shadow: var(--shadow-lg);
        }

        .btn-hero-primary .arrow {
            transition: transform .3s;
        }

        .btn-hero-primary:hover .arrow {
            transform: translateX(4px);
        }

    .carousel-control-prev, .carousel-control-next {
        width: 48px;
        height: 48px;
        top: 50%;
        transform: translateY(-50%);
        bottom: auto;
        background: rgba(18,32,27,.55);
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 24px;
        opacity: 1;
        transition: var(--transition);
    }

        .carousel-control-prev:hover, .carousel-control-next:hover {
            background: var(--emerald-deep);
        }

    .carousel-control-prev-icon, .carousel-control-next-icon {
        width: 14px;
        height: 14px;
    }

    .carousel-indicators {
        bottom: 30px;
        gap: 8px;
    }

        .carousel-indicators button {
            width: 7px;
            height: 7px;
            background: rgba(18,32,27,.3);
            border: none;
            transition: all .3s;
            transform: rotate(45deg);
        }

            .carousel-indicators button.active {
                background: var(--gold);
            }

    @@media(max-width: 991px) {
        .luxury-hero-left {
            padding: 60px 48px;
            width: 68%;
        }
    }

    @@media(max-width: 768px) {
        .luxury-hero {
            display: block;
            min-height: auto;
            background: var(--stone);
        }

        .luxury-hero-img-wrap {
            position: relative;
            width: 100%;
            height: auto;
            aspect-ratio: 1.6;
        }

            .luxury-hero-img-wrap::after {
                background: linear-gradient(180deg, transparent 50%, var(--stone) 100%);
            }

        .luxury-hero-left {
            width: 100%;
            padding: 36px 24px;
            background: var(--stone);
        }
    }

    /* ===== MARQUEE / TRUST STRIP ===== */
    .brands-bar {
        background: var(--emerald-deep);
        overflow: hidden;
    }

    .brands-track {
        display: flex;
        align-items: center;
        animation: marqueeScroll 26s linear infinite;
        width: max-content;
        padding: 16px 0;
    }

        .brands-track:hover {
            animation-play-state: paused;
        }

    @@keyframes marqueeScroll {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    .brand-chip {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 40px;
        color: rgba(250,246,238,.55);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .18em;
        text-transform: uppercase;
        white-space: nowrap;
    }

        .brand-chip i {
            color: var(--gold-light);
            font-size: 13px;
        }

    /* ===== CATEGORY STRIP ===== */
    .cat-strip {
        padding: 84px 0 20px;
        background: var(--ivory);
    }

    .section-tag {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .24em;
        text-transform: uppercase;
        color: var(--emerald);
        margin-bottom: 14px;
    }

        .section-tag .facet-dot {
            width: 6px;
            height: 6px;
            background: var(--gold);
            transform: rotate(45deg);
            display: inline-block;
        }

    .section-title-xl {
        font-family: 'Fraunces', serif;
        font-size: clamp(1.7rem, 3.2vw, 2.5rem);
        font-weight: 500;
        color: var(--ink);
        line-height: 1.22;
        margin-bottom: 10px;
    }

        .section-title-xl em {
            font-style: italic;
            color: var(--emerald);
        }

    .section-sub {
        font-size: 14px;
        color: var(--ink-muted);
        margin-bottom: 44px;
        max-width: 460px;
    }

    .section-head-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 44px;
    }

    .cat-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .cat-card {
        position: relative;
        overflow: hidden;
        background: var(--ink);
        aspect-ratio: auto;
        height: 460px;
        cursor: pointer;
        text-decoration: none !important;
        display: block;
    }

    .cat-card-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        transition: transform .8s cubic-bezier(.16,1,.3,1);
        filter: saturate(.85) brightness(.7);
    }

    .cat-card:hover .cat-card-bg {
        transform: scale(1.07);
        filter: saturate(1) brightness(.55);
    }

    .cat-card::before {
        content: '';
        position: absolute;
        top: 18px;
        right: 18px;
        width: 34px;
        height: 34px;
        border: 1px solid rgba(250,246,238,.5);
        transform: rotate(45deg);
        transition: var(--transition);
    }

    .cat-card:hover::before {
        border-color: var(--gold-light);
        transform: rotate(90deg);
    }

    .cat-card-content {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        padding: 30px;
        background: linear-gradient(to top, rgba(12,38,32,.75) 0%, transparent 55%);
    }

    .cat-card-eyebrow {
        font-size: 10px;
        letter-spacing: .3em;
        text-transform: uppercase;
        color: var(--gold-light);
        margin-bottom: 8px;
        opacity: 0;
        transform: translateY(8px);
        transition: var(--transition);
    }

    .cat-card:hover .cat-card-eyebrow {
        opacity: 1;
        transform: translateY(0);
    }

    .cat-card-name {
        font-family: 'Fraunces', serif;
        font-size: 1.7rem;
        font-weight: 500;
        color: white;
        letter-spacing: .02em;
    }

    /* ===== PRODUCTS ===== */
    .products-section {
        padding: 88px 0;
        background: var(--ivory);
    }

    .prod-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px 24px;
    }

    .prod-card {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        display: flex;
        flex-direction: column;
        position: relative;
        text-decoration: none !important;
    }

        .prod-card:hover {
            transform: none !important;
        }

    .prod-img-wrap {
        position: relative;
        overflow: hidden;
        background: var(--stone) !important;
        aspect-ratio: 1/1 !important;
        padding: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .prod-img-wrap::before {
            content: '';
            position: absolute;
            top: 10px;
            right: 10px;
            width: 22px;
            height: 22px;
            border-top: 1px solid var(--gold);
            border-right: 1px solid var(--gold);
            opacity: 0;
            transform: translate(-6px,6px);
            transition: var(--transition);
            z-index: 2;
        }

        .prod-img-wrap::after {
            content: '';
            position: absolute;
            bottom: 10px;
            left: 10px;
            width: 22px;
            height: 22px;
            border-bottom: 1px solid var(--gold);
            border-left: 1px solid var(--gold);
            opacity: 0;
            transform: translate(6px,-6px);
            transition: var(--transition);
            z-index: 2;
        }

    .prod-card:hover .prod-img-wrap::before, .prod-card:hover .prod-img-wrap::after {
        opacity: 1;
        transform: translate(0,0);
    }

    .prod-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: contain !important;
        transition: transform .7s cubic-bezier(.16,1,.3,1);
        display: block;
    }

    .prod-card:hover .prod-img-wrap img {
        transform: scale(1.06);
    }

    .prod-no-img {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: var(--stone);
        color: var(--ink-muted);
        gap: 8px;
        font-size: 13px;
    }

        .prod-no-img i {
            font-size: 2rem;
            opacity: .4;
        }

    .prod-body {
        padding: 16px 2px 0 !important;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        text-align: left;
        gap: 6px;
    }

    .prod-name {
        font-family: 'Inter', sans-serif !important;
        font-size: 12.5px !important;
        font-weight: 600 !important;
        color: var(--ink) !important;
        text-transform: uppercase;
        letter-spacing: .04em;
        line-height: 1.45;
    }

    .prod-stars {
        display: flex;
        align-items: center;
        gap: 3px;
    }

        .prod-stars i {
            font-size: 10px;
            color: var(--gold);
        }

    .prod-price {
        font-family: 'Fraunces', serif !important;
        font-size: 15px !important;
        font-weight: 600 !important;
        color: var(--emerald) !important;
        display: inline-block;
    }

    .view-all-wrap {
        text-align: center;
        margin-top: 56px;
    }

    .btn-outline-facet {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: transparent;
        color: var(--ink) !important;
        border: 1px solid var(--ink);
        padding: 14px 32px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
        text-decoration: none !important;
        transition: var(--transition);
    }

        .btn-outline-facet:hover {
            background: var(--ink);
            color: var(--ivory) !important;
        }

    /* ===== PROMO BANNER ===== */
    .promo-banner {
        margin: 0 0 88px;
        background: var(--emerald-deep);
        overflow: hidden;
        position: relative;
        display: flex;
        align-items: center;
        min-height: 300px;
    }

    .promo-banner-bg {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 76% 40%, rgba(182,135,47,.16) 0%, transparent 50%), radial-gradient(circle at 15% 60%, rgba(232,205,138,.08) 0%, transparent 55%);
    }

    .promo-content {
        position: relative;
        z-index: 1;
        padding: 52px 60px;
        max-width: 560px;
    }

    .promo-eyebrow {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .3em;
        text-transform: uppercase;
        color: var(--gold-light);
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .promo-title {
        font-family: 'Fraunces', serif;
        font-size: clamp(1.7rem, 3.2vw, 2.6rem);
        color: var(--ivory);
        font-weight: 500;
        line-height: 1.2;
        margin-bottom: 18px;
    }

        .promo-title .accent {
            color: var(--gold-light);
            font-style: italic;
        }

    .promo-desc {
        color: rgba(250,246,238,.6);
        font-size: 14.5px;
        line-height: 1.7;
        margin-bottom: 30px;
    }

    .promo-img-side {
        position: absolute;
        right: 0;
        top: 0;
        bottom: 0;
        width: 42%;
        overflow: hidden;
    }

        .promo-img-side img {
            height: 100%;
            width: 100%;
            object-fit: cover;
            opacity: .3;
            mix-blend-mode: luminosity;
        }

        .promo-img-side::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, var(--emerald-deep) 0%, transparent 40%);
        }

    /* ===== WHY ===== */
    .why-section {
        padding: 88px 0;
        background: var(--stone);
    }

    .why-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 24px;
        margin-top: 20px;
    }

    .why-card {
        background: var(--ivory);
        padding: 38px 26px;
        text-align: left;
        transition: var(--transition);
        position: relative;
    }

        .why-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--gold);
            transition: width .4s cubic-bezier(.16,1,.3,1);
        }

        .why-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-md);
        }

            .why-card:hover::after {
                width: 100%;
            }

    .why-icon-wrap {
        width: 46px;
        height: 46px;
        background: var(--emerald-glow);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 22px;
        font-size: 18px;
        color: var(--emerald);
        transition: var(--transition);
        transform: rotate(45deg);
    }

        .why-icon-wrap i {
            transform: rotate(-45deg);
        }

    .why-card:hover .why-icon-wrap {
        background: var(--emerald);
        color: var(--gold-light);
    }

    .why-card h5 {
        font-family: 'Fraunces', serif;
        font-size: 1.1rem;
        font-weight: 500;
        color: var(--ink);
        margin-bottom: 10px;
    }

    .why-card p {
        font-size: 13px;
        color: var(--ink-muted);
        line-height: 1.7;
    }

    /* ===== NEWSLETTER ===== */
    .newsletter-wrap {
        padding: 110px 0;
        background: var(--emerald-deep);
        position: relative;
        overflow: hidden;
    }

        .newsletter-wrap::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%,-50%);
            width: 640px;
            height: 640px;
            background: radial-gradient(circle, rgba(182,135,47,.14) 0%, transparent 70%);
            pointer-events: none;
        }

    .newsletter-inner {
        max-width: 560px;
        margin: 0 auto;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .nl-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 54px;
        height: 54px;
        background: rgba(232,205,138,.12);
        font-size: 20px;
        color: var(--gold-light);
        margin-bottom: 26px;
        transform: rotate(45deg);
        animation: slowSpin 12s linear infinite;
    }

        .nl-icon i {
            transform: rotate(-45deg);
        }

    @@keyframes slowSpin {
        from {
            transform: rotate(45deg);
        }

        to {
            transform: rotate(405deg);
        }
    }

    .nl-title {
        font-family: 'Fraunces', serif;
        font-size: clamp(1.7rem, 3vw, 2.3rem);
        font-weight: 500;
        color: var(--ivory);
        margin-bottom: 14px;
        line-height: 1.2;
    }

    .nl-sub {
        color: rgba(250,246,238,.5);
        font-size: 14.5px;
        margin-bottom: 38px;
        line-height: 1.7;
    }

    .nl-form {
        display: flex;
        background: rgba(250,246,238,.06);
        border: 1px solid rgba(250,246,238,.14);
        padding: 6px 6px 6px 22px;
        gap: 8px;
        align-items: center;
    }

        .nl-form:focus-within {
            border-color: var(--gold);
        }

    .nl-input {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: var(--ivory);
        font-size: 14px;
        font-family: 'Inter',sans-serif;
        padding: 8px 0;
    }

        .nl-input::placeholder {
            color: rgba(250,246,238,.35);
        }

    .nl-btn {
        flex-shrink: 0;
        background: var(--gold);
        color: var(--emerald-deep);
        border: none;
        padding: 13px 26px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        cursor: pointer;
        font-family: 'Inter',sans-serif;
        transition: var(--transition);
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .nl-btn:hover {
            background: var(--gold-light);
        }

    #hiddenCartForm {
        display: none;
    }

    /* RESPONSIVE */
    @@media(max-width:1199px) {
        .prod-grid {
            grid-template-columns: repeat(3,1fr);
        }

        .why-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media(max-width:991px) {
        .promo-img-side {
            display: none;
        }

        .promo-content {
            padding: 40px;
        }

        .prod-grid {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media(max-width:767px) {
        .hero-cta-row {
            flex-direction: column;
        }

        .cat-grid {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .cat-card {
            height: 220px;
        }

        .cat-card-content {
            padding: 20px;
        }

        .cat-card-name {
            font-size: 1.3rem;
        }

        .why-grid {
            grid-template-columns: repeat(2,1fr);
        }

        .promo-content {
            padding: 32px 24px;
        }

        .promo-banner {
            min-height: auto;
        }

        .nl-form {
            flex-direction: column;
            padding: 14px 16px;
        }

        .nl-btn {
            width: 100%;
            justify-content: center;
        }
    }

    @@media(max-width:575px) {
        .cat-grid {
            grid-template-columns: repeat(2,1fr);
            gap: 10px;
        }

        .cat-card {
            height: 170px;
        }

            .cat-card::before {
                width: 22px;
                height: 22px;
                top: 12px;
                right: 12px;
            }

        .cat-card-content {
            padding: 14px;
        }

        .cat-card-eyebrow {
            font-size: 9px;
            margin-bottom: 4px;
        }

        .cat-card-name {
            font-size: 1rem;
        }

        .prod-grid {
            grid-template-columns: repeat(2,1fr);
            gap: 16px 14px;
        }

