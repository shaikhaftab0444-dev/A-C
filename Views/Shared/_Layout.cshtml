<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AQSA COLLECTION</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        :root {
            /* ===== FACETED GEM PALETTE ===== */
            --ink: #12201b;
            --ink-soft: #3f4f47;
            --ink-muted: #7d8b83;
            --ivory: #faf6ee;
            --stone: #f1ebdc;
            --stone-2: #e6dcc7;
            --emerald: #1f4d3d;
            --emerald-deep: #0c2620;
            --emerald-glow: rgba(31,77,61,.14);
            --gold: #b6872f;
            --gold-light: #e8cd8a;
            --gold-glow: rgba(182,135,47,.18);
            --rose: #c98a7d;
            --green-ok: #2f7a52;
            --nav-h: 108px;
            --cut: 14px;
            --transition: all .35s cubic-bezier(.4,0,.2,1);
            --shadow-sm: 0 2px 14px rgba(18,32,27,.06);
            --shadow-md: 0 10px 34px rgba(18,32,27,.10);
            --shadow-lg: 0 26px 60px rgba(18,32,27,.16);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background: var(--ivory);
            color: var(--ink);
        }

        ::selection {
            background: var(--gold-light);
            color: var(--ink);
        }

        /* facet-cut: the signature angular corner motif used across cards, buttons, panels */
        .facet-cut {
            clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut)));
        }

        .facet-cut-sm {
            clip-path: polygon(0 0, calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
        }

        [data-reveal] {
            opacity: 0;
            transform: translateY(26px);
            transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1);
        }

            [data-reveal].in-view {
                opacity: 1;
                transform: translateY(0);
            }

        @@media (prefers-reduced-motion: reduce) {
            [data-reveal] {
                opacity: 1 !important;
                transform: none !important;
                transition: none !important;
            }

            * {
                animation-duration: 0.001ms !important;
                animation-iteration-count: 1 !important;
            }
        }

        /* ===== TOPBAR ===== */
        .topbar {
            background: var(--emerald-deep);
            color: rgba(250,246,238,.75);
            font-size: 11.5px;
            font-weight: 600;
            letter-spacing: .12em;
            text-transform: uppercase;
            text-align: center;
            padding: 8px 12px;
        }

            .topbar strong {
                color: var(--gold-light);
                font-weight: 700;
            }

        /* ===== NAVBAR ===== */
        .main-header {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(250,246,238,.86);
            backdrop-filter: blur(16px) saturate(140%);
            -webkit-backdrop-filter: blur(16px) saturate(140%);
            border-bottom: 1px solid rgba(18,32,27,.08);
        }

        .navbar-brand {
            font-family: 'Fraunces', serif;
            font-weight: 600;
            font-optical-sizing: auto;
            font-size: 1.9rem;
            color: var(--ink) !important;
            letter-spacing: .1em;
            text-decoration: none !important;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .brand-mark {
            width: 9px;
            height: 9px;
            background: var(--gold);
            transform: rotate(45deg);
            display: inline-block;
        }

        .nav-icon-btn {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            color: var(--ink-soft) !important;
            transition: var(--transition);
            font-size: 15px;
            text-decoration: none !important;
        }

            .nav-icon-btn:hover {
                color: var(--gold) !important;
                transform: translateY(-2px);
            }

        .nav-badge {
            position: absolute;
            top: -2px;
            right: -2px;
            background: var(--emerald);
            color: var(--ivory);
            font-size: 9px;
            font-weight: 800;
            min-width: 16px;
            height: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid var(--ivory);
            line-height: 1;
        }

        .premium-nav-link {
            font-family: 'Inter', sans-serif !important;
            font-size: 11px !important;
            font-weight: 700 !important;
            letter-spacing: .16em !important;
            color: var(--ink-soft) !important;
            text-transform: uppercase !important;
            padding: 6px 2px !important;
            position: relative;
            text-decoration: none !important;
            transition: color .3s ease;
            display: inline-block;
        }

            .premium-nav-link::after {
                content: '';
                position: absolute;
                width: 100%;
                transform: scaleX(0);
                height: 1.5px;
                bottom: 0;
                left: 0;
                background: var(--gold);
                transform-origin: bottom right;
                transition: transform .45s cubic-bezier(.16,1,.3,1);
            }

            .premium-nav-link:hover::after {
                transform: scaleX(1);
                transform-origin: bottom left;
            }

            .premium-nav-link:hover {
                color: var(--ink) !important;
            }

            .premium-nav-link.is-accent {
                color: var(--emerald) !important;
            }

                .premium-nav-link.is-accent::after {
                    background: var(--emerald);
                }

        .main-header ul.nav::-webkit-scrollbar {
            display: none !important;
        }

        .main-header ul.nav {
            -ms-overflow-style: none !important;
            scrollbar-width: none !important;
        }

        @@media(max-width: 768px) {
            .navbar-brand {
                font-size: 1.5rem;
            }

            .premium-nav-link {
                font-size: 10px !important;
                letter-spacing: .1em !important;
            }
        }

        /* ===== MOBILE MENU TOGGLE ===== */
        .menu-toggle-btn {
            display: none;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            background: none;
            border: none;
            color: var(--ink);
            font-size: 18px;
            padding: 0;
            cursor: pointer;
        }

        .desktop-nav-row {
            display: block;
        }

        @@media(max-width: 768px) {
            .menu-toggle-btn {
                display: flex;
            }

            .desktop-nav-row {
                display: none !important;
            }
        }

        /* ===== MOBILE OFF-CANVAS NAV ===== */
        .mobile-nav-overlay {
            position: fixed;
            inset: 0;
            background: rgba(12,38,32,.55);
            backdrop-filter: blur(2px);
            z-index: 1400;
            opacity: 0;
            visibility: hidden;
            transition: opacity .35s ease;
        }

            .mobile-nav-overlay.is-open {
                opacity: 1;
                visibility: visible;
            }

        .mobile-nav-panel {
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            width: min(84vw, 340px);
            background: var(--ivory);
            z-index: 1500;
            transform: translateX(100%);
            transition: transform .4s cubic-bezier(.16,1,.3,1);
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow-lg);
        }

            .mobile-nav-panel.is-open {
                transform: translateX(0);
            }

        .mobile-nav-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 22px;
            border-bottom: 1px solid rgba(18,32,27,.08);
            background: var(--emerald-deep);
        }

            .mobile-nav-head span {
                font-family: 'Fraunces', serif;
                font-size: 1.15rem;
                font-weight: 600;
                color: var(--ivory);
                letter-spacing: .06em;
            }

        .mobile-nav-close {
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(250,246,238,.08);
            border: none;
            color: var(--gold-light);
            font-size: 15px;
            cursor: pointer;
            transition: var(--transition);
        }

            .mobile-nav-close:hover {
                background: rgba(250,246,238,.16);
            }

        .mobile-nav-links {
            list-style: none;
            margin: 0;
            padding: 10px 0;
            overflow-y: auto;
            flex: 1;
        }

            .mobile-nav-links li {
                border-bottom: 1px solid rgba(18,32,27,.06);
            }

            .mobile-nav-links a {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 16px 22px;
                font-family: 'Inter', sans-serif;
                font-size: 13px;
                font-weight: 700;
                letter-spacing: .1em;
                text-transform: uppercase;
                color: var(--ink-soft);
                text-decoration: none !important;
                transition: var(--transition);
            }

                .mobile-nav-links a i {
                    font-size: 11px;
                    color: var(--gold);
                    opacity: 0;
                    transform: translateX(-4px);
                    transition: var(--transition);
                }

                .mobile-nav-links a:hover {
                    color: var(--ink);
                    background: var(--stone);
                    padding-left: 28px;
                }

                    .mobile-nav-links a:hover i {
                        opacity: 1;
                        transform: translateX(0);
                    }

                .mobile-nav-links a.is-accent {
                    color: var(--emerald);
                }

        .mobile-nav-foot {
            padding: 18px 22px 24px;
            border-top: 1px solid rgba(18,32,27,.08);
            display: flex;
            gap: 14px;
        }

            .mobile-nav-foot a {
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 12px;
                background: var(--stone);
                color: var(--ink) !important;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: .08em;
                text-transform: uppercase;
                text-decoration: none !important;
                transition: var(--transition);
            }

                .mobile-nav-foot a:hover {
                    background: var(--emerald);
                    color: var(--ivory) !important;
                }

        body.mobile-nav-locked {
            overflow: hidden;
        }

        /* ===== ALERTS ===== */
        .global-alert-zone {
            position: fixed;
            top: calc(var(--nav-h) + 12px);
            right: 16px;
            z-index: 1200;
            display: flex;
            flex-direction: column;
            gap: 10px;
            pointer-events: none;
        }

            .global-alert-zone .alert {
                pointer-events: all;
                border-radius: 0;
                border: none;
                box-shadow: var(--shadow-lg);
                font-size: 14px;
                font-weight: 500;
                padding: 14px 18px;
                display: flex;
                align-items: center;
                gap: 10px;
                min-width: 280px;
                animation: alertSlide .4s cubic-bezier(.16,1,.3,1);
            }

        @@keyframes alertSlide {
            from {
                transform: translateX(110%);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        .alert-success {
            background: var(--ivory);
            border-left: 3px solid var(--green-ok) !important;
            color: var(--ink);
        }

        .alert-danger {
            background: var(--ivory);
            border-left: 3px solid #b3432f !important;
            color: var(--ink);
        }

        /* ===== FOOTER ===== */
        .site-footer {
            background: var(--emerald-deep);
            color: rgba(250,246,238,.55);
            position: relative;
        }

            .site-footer::before {
                content: '';
                display: block;
                height: 3px;
                background: linear-gradient(90deg, var(--gold) 0%, var(--gold-light) 50%, var(--gold) 100%);
            }

        .footer-top {
            padding: 64px 0 40px;
            border-bottom: 1px solid rgba(250,246,238,.08);
        }

        .footer-brand {
            font-family: 'Fraunces', serif;
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--ivory);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: .06em;
        }

        .footer-brand-desc {
            font-size: 13px;
            color: rgba(250,246,238,.4);
            line-height: 1.75;
            max-width: 270px;
        }

        .footer-heading {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .2em;
            text-transform: uppercase;
            color: var(--gold-light);
            margin-bottom: 22px;
        }

        .footer-link {
            display: block;
            color: rgba(250,246,238,.55);
            text-decoration: none;
            font-size: 13px;
            margin-bottom: 11px;
            transition: var(--transition);
        }

            .footer-link:hover {
                color: var(--ivory);
                padding-left: 5px;
            }

        .footer-social {
            display: flex;
            gap: 10px;
            margin-top: 26px;
        }

        .social-btn {
            width: 36px;
            height: 36px;
            background: rgba(250,246,238,.06);
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(250,246,238,.55);
            font-size: 14px;
            text-decoration: none;
            transition: var(--transition);
        }

            .social-btn:hover {
                background: var(--gold);
                color: var(--emerald-deep);
            }

        .trust-tile {
            background: rgba(250,246,238,.045);
            padding: 15px 16px;
            display: flex;
            gap: 11px;
            align-items: center;
            border: 1px solid rgba(250,246,238,.06);
            transition: var(--transition);
        }

            .trust-tile:hover {
                border-color: rgba(182,135,47,.35);
                background: rgba(250,246,238,.07);
            }

        .footer-bottom {
            padding: 24px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }

            .footer-bottom span {
                font-size: 12px;
            }

        .footer-bottom-links {
            display: flex;
            gap: 22px;
        }

            .footer-bottom-links a {
                font-size: 12px;
                color: rgba(250,246,238,.35);
                text-decoration: none;
                transition: var(--transition);
            }

                .footer-bottom-links a:hover {
                    color: rgba(250,246,238,.75);
                }

        @@media (max-width: 767px) {
            .footer-top .row > div {
                margin-bottom: 32px;
            }

            .footer-bottom {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
</head>
<body>

    <div class="topbar">Complimentary shipping on orders over <strong>₹999</strong> &nbsp;·&nbsp; Certified authentic, always</div>

    <!-- ===== NAVBAR ===== -->
    <header class="main-header" style="padding: 15px 0 10px 0;">
        <div class="container-fluid px-3 px-lg-5">
            <div class="d-flex justify-content-between align-items-center position-relative mb-2">
                <div style="width: 90px;" class="d-flex align-items-center">
                    <button type="button" class="menu-toggle-btn" id="mobileMenuOpenBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mobileNavPanel">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>

                <a class="navbar-brand text-uppercase mx-auto" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"></span> AQSA COLLECTION
                </a>

                <div class="d-flex align-items-center gap-1" style="width: 90px; justify-content: flex-end;">
                    <a asp-controller="Home" asp-action="Products" class="nav-icon-btn" title="Search"><i class="fas fa-search"></i></a>
                    <a asp-controller="Wishlist" asp-action="Index" class="nav-icon-btn position-relative" title="Wishlist">
                        <i class="fas fa-heart"></i>
                        <span class="nav-badge" id="wishlistBadge" style="display:none;">0</span>
                    </a>
                    <a asp-controller="Cart" asp-action="Index" class="nav-icon-btn position-relative" title="Cart">
                        <i class="fas fa-shopping-bag"></i>
                        <span class="nav-badge" id="cartBadge" style="display:none;">0</span>
                    </a>
                </div>
            </div>

            <div class="desktop-nav-row" style="border-top: 1px solid rgba(18,32,27,.08); padding-top: 10px;">
                <ul class="nav justify-content-center text-uppercase flex-nowrap" style="gap: 22px; overflow-x: auto; white-space: nowrap;">
                    <li class="nav-item"><a class="premium-nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="premium-nav-link" asp-controller="Home" asp-action="Products">New In</a></li>
                    <li class="nav-item"><a class="premium-nav-link" asp-controller="Home" asp-action="Products" asp-route-search="Necklace">Necklaces</a></li>
                    <li class="nav-item"><a class="premium-nav-link" asp-controller="Home" asp-action="Products" asp-route-search="Ring">Rings</a></li>
                    <li class="nav-item"><a class="premium-nav-link" asp-controller="Home" asp-action="Products" asp-route-search="Earring">Earrings</a></li>
                    <li class="nav-item"><a class="premium-nav-link" asp-controller="Home" asp-action="Products" asp-route-search="Bracelet">Bracelets</a></li>
                    <li class="nav-item"><a class="premium-nav-link" asp-controller="Home" asp-action="Products" asp-route-categoryId="2">Accessories</a></li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item"><a class="premium-nav-link" asp-controller="Account" asp-action="Profile">Account</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item"><a class="premium-nav-link is-accent" asp-controller="Admin" asp-action="Index">Admin</a></li>
                        }
                    }
                    else
                    {
                        <li class="nav-item"><a class="premium-nav-link" asp-controller="Account" asp-action="Login">Account</a></li>
                    }
                    <li class="nav-item"><a class="premium-nav-link" asp-controller="Cart" asp-action="Index">Cart (<span id="cartCountLabel">0</span>)</a></li>
                </ul>
            </div>
        </div>
    </header>

    <!-- ===== MOBILE OFF-CANVAS NAV ===== -->
    <div class="mobile-nav-overlay" id="mobileNavOverlay"></div>
    <nav class="mobile-nav-panel" id="mobileNavPanel" aria-label="Mobile navigation">
        <div class="mobile-nav-head">
            <span><span class="brand-mark" style="background:var(--gold-light);"></span> Menu</span>
            <button type="button" class="mobile-nav-close" id="mobileMenuCloseBtn" aria-label="Close menu"><i class="fas fa-times"></i></button>
        </div>
        <ul class="mobile-nav-links">
            <li><a asp-controller="Home" asp-action="Index">Home <i class="fas fa-arrow-right"></i></a></li>
            <li><a asp-controller="Home" asp-action="Products">New In <i class="fas fa-arrow-right"></i></a></li>
            <li><a asp-controller="Home" asp-action="Products" asp-route-search="Necklace">Necklaces <i class="fas fa-arrow-right"></i></a></li>
            <li><a asp-controller="Home" asp-action="Products" asp-route-search="Ring">Rings <i class="fas fa-arrow-right"></i></a></li>
            <li><a asp-controller="Home" asp-action="Products" asp-route-search="Earring">Earrings <i class="fas fa-arrow-right"></i></a></li>
            <li><a asp-controller="Home" asp-action="Products" asp-route-search="Bracelet">Bracelets <i class="fas fa-arrow-right"></i></a></li>
            <li><a asp-controller="Home" asp-action="Products" asp-route-categoryId="2">Accessories <i class="fas fa-arrow-right"></i></a></li>
            @if (User.Identity.IsAuthenticated)
            {
                <li><a asp-controller="Account" asp-action="Profile">Account <i class="fas fa-arrow-right"></i></a></li>
                @if (User.IsInRole("Admin"))
                {
                    <li><a class="is-accent" asp-controller="Admin" asp-action="Index">Admin <i class="fas fa-arrow-right"></i></a></li>
                }
            }
            else
            {
                <li><a asp-controller="Account" asp-action="Login">Account <i class="fas fa-arrow-right"></i></a></li>
            }
        </ul>
        <div class="mobile-nav-foot">
            <a asp-controller="Wishlist" asp-action="Index"><i class="fas fa-heart"></i> Wishlist</a>
            <a asp-controller="Cart" asp-action="Index"><i class="fas fa-shopping-bag"></i> Cart</a>
        </div>
    </nav>

    <!-- ===== ALERT ZONE ===== -->
    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="global-alert-zone">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle" style="color: var(--green-ok);"></i>
                    @TempData["Success"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle" style="color:#b3432f;"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
        </div>
    }

    <!-- ===== MAIN ===== -->
    <main>
        @RenderBody()
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="site-footer">
        <div class="footer-top">
            <div class="container">
                <div class="row g-4">
                    <div class="col-lg-4 col-md-6">
                        <div class="footer-brand text-uppercase"><span class="brand-mark"></span> AQSA COLLECTION</div>
                        <p class="footer-brand-desc">Your premier online boutique for fine jewelry and luxury accessories. Cut, set and finished with elegance in every detail.</p>
                        <div class="footer-social">
                            <a href="#" class="social-btn"><i class="fab fa-instagram"></i></a>
                            <a href="#" class="social-btn"><i class="fab fa-twitter"></i></a>
                            <a href="#" class="social-btn"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" class="social-btn"><i class="fab fa-youtube"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-3 col-6">
                        <div class="footer-heading">Shop</div>
                        <a asp-controller="Home" asp-action="Products" class="footer-link">All Products</a>
                        <a asp-controller="Home" asp-action="Products" asp-route-categoryId="1" class="footer-link">Jewelry</a>
