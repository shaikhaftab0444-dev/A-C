@model BrandsStore.ViewModel.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<style>
    :root {
        --ink: #12201b;
        --ink-soft: #3f4f47;
        --ink-muted: #7d8b83;
        --ivory: #faf6ee;
        --stone: #f1ebdc;
        --stone-2: #e6dcc7;
        --emerald: #1f4d3d;
        --emerald-deep: #0c2620;
        --emerald-glow: rgba(31,77,61,.10);
        --gold: #b6872f;
        --gold-light: #e8cd8a;
        --gold-glow: rgba(182,135,47,.16);
        --green-ok: #2f7a52;
        --cut: 18px;
        --tr: all .3s cubic-bezier(.4,0,.2,1);
    }

    * {
        box-sizing: border-box;
    }

    .auth-page {
        font-family: 'Inter',sans-serif;
        min-height: 100vh;
        background: var(--stone);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
    }

    /* SPLIT LAYOUT (panel right this time) */
    .auth-wrap {
        display: grid;
        grid-template-columns: 460px 1fr;
        max-width: 960px;
        width: 100%;
        background: var(--ivory);
        overflow: hidden;
        box-shadow: 0 26px 70px rgba(18,32,27,.16);
        border: 1px solid var(--stone-2);
    }

    /* FORM SIDE (left) */
    .auth-form-wrap {
        padding: 44px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .auth-form-title {
        font-family: 'Fraunces',serif;
        font-size: 1.5rem;
        font-weight: 500;
        color: var(--ink);
        margin: 0 0 4px;
    }

    .auth-form-sub {
        font-size: 13px;
        color: var(--ink-muted);
        margin: 0 0 26px;
    }

    /* VALIDATION */
    .val-summary {
        background: rgba(179,67,47,.07);
        border: 1px solid rgba(179,67,47,.22);
        padding: 12px 16px;
        margin-bottom: 18px;
        font-size: 13px;
        color: #b3432f;
        display: none;
    }

    /* FIELD GROUPS */
    .fg {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-bottom: 15px;
    }

    .fg-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-bottom: 15px;
    }

    .fl {
        font-size: 11px;
        font-weight: 800;
        color: var(--ink);
        text-transform: uppercase;
        letter-spacing: .1em;
    }

    .input-wrap {
        position: relative;
    }

        .input-wrap i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--ink-muted);
            font-size: 13px;
            pointer-events: none;
        }

    .fi {
        width: 100%;
        background: var(--stone);
        border: 1.5px solid var(--stone-2);
        padding: 11px 13px 11px 38px;
        font-family: 'Inter',sans-serif;
        font-size: 13px;
        color: var(--ink);
        outline: none;
        transition: var(--tr);
    }

        .fi:focus {
            border-color: var(--gold);
            background: var(--ivory);
            box-shadow: 0 0 0 3px var(--gold-glow);
        }

    .field-error {
        font-size: 11px;
        color: #b3432f;
        margin-top: 2px;
    }

    /* PASSWORD STRENGTH */
    .pwd-strength {
        display: flex;
        gap: 4px;
        margin-top: 6px;
    }

    .ps-bar {
        height: 3px;
        flex: 1;
        background: var(--stone-2);
        transition: var(--tr);
    }

        .ps-bar.weak {
            background: #b3432f;
        }

        .ps-bar.medium {
            background: var(--gold);
        }

        .ps-bar.strong {
            background: var(--green-ok);
        }

    .ps-label {
        font-size: 10px;
        font-weight: 700;
        color: var(--ink-muted);
        margin-top: 4px;
    }

    /* SUBMIT */
    .btn-submit {
        width: 100%;
        padding: 14px;
        background: var(--emerald);
        color: var(--ivory);
        border: none;
        font-family: 'Inter',sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        cursor: pointer;
        transition: var(--tr);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-bottom: 20px;
    }

        .btn-submit:hover {
            background: var(--emerald-deep);
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(31,77,61,.28);
        }

    .auth-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

        .auth-divider::before, .auth-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--stone-2);
        }

        .auth-divider span {
            font-size: 11px;
            font-weight: 700;
            color: var(--ink-muted);
            text-transform: uppercase;
            letter-spacing: .14em;
        }

    .login-row {
        text-align: center;
        font-size: 13px;
        color: var(--ink-muted);
    }

        .login-row a {
            font-weight: 800;
            color: var(--ink);
            text-decoration: none;
            transition: var(--tr);
        }

            .login-row a:hover {
                color: var(--emerald);
            }

    /* RIGHT PANEL */
    .auth-panel {
        position: relative;
        overflow: hidden;
        background: var(--emerald-deep);
        padding: 52px 40px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .auth-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 70% 18%,rgba(182,135,47,.20) 0%,transparent 50%), radial-gradient(circle at 20% 90%,rgba(232,205,138,.10) 0%,transparent 45%);
        }

        .auth-panel::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(250,246,238,.035) 1px,transparent 1px), linear-gradient(90deg,rgba(250,246,238,.035) 1px,transparent 1px);
            background-size: 36px 36px;
        }

    .panel-content {
        position: relative;
        z-index: 1;
    }

    .panel-logo {
        font-family: 'Fraunces',serif;
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--ivory);
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 44px;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .panel-logo-dot {
        width: 7px;
        height: 7px;
        background: var(--gold);
        transform: rotate(45deg);
        display: inline-block;
    }

    .panel-tag {
        font-size: 11px;
        font-weight: 700;
        color: var(--gold-light);
        text-transform: uppercase;
        letter-spacing: .22em;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .panel-tag::before {
            content: '';
            width: 16px;
            height: 2px;
            background: var(--gold);
        }

    .panel-title {
        font-family: 'Fraunces',serif;
        font-size: clamp(1.4rem,2.4vw,1.9rem);
        font-weight: 500;
        color: var(--ivory);
        margin: 0 0 12px;
        line-height: 1.3;
    }

        .panel-title em {
            font-style: italic;
            color: var(--gold-light);
        }

    .panel-sub {
        font-size: 13px;
        color: rgba(250,246,238,.45);
        line-height: 1.75;
        margin: 0 0 36px;
    }

    /* PERKS LIST */
    .perks {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .perk {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        background: rgba(250,246,238,.045);
        border: 1px solid rgba(250,246,238,.08);
        transition: var(--tr);
    }

        .perk:hover {
            border-color: rgba(182,135,47,.35);
            background: rgba(250,246,238,.07);
        }

    .perk-ico {
        width: 30px;
        height: 30px;
        background: rgba(250,246,238,.06);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        flex-shrink: 0;
        transform: rotate(45deg);
    }

        .perk-ico i {
            transform: rotate(-45deg);
            color: var(--gold-light);
        }

    .perk-text {
        font-size: 12px;
        color: rgba(250,246,238,.55);
        line-height: 1.4;
    }

        .perk-text strong {
            color: rgba(250,246,238,.9);
            display: block;
            font-size: 12.5px;
            font-family: 'Fraunces', serif;
            font-weight: 500;
            margin-bottom: 1px;
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .auth-wrap {
        animation: fadeUp .55s cubic-bezier(.16,1,.3,1) both;
    }

    @@media(max-width:750px) {
        .auth-wrap {
            grid-template-columns: 1fr;
        }

        .auth-panel {
            display: none;
        }

        .auth-form-wrap {
            padding: 36px 24px;
        }

        .fg-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="auth-page">
    <div class="auth-wrap">

        <!-- FORM SIDE (LEFT) -->
        <div class="auth-form-wrap">
            <div class="auth-form-title">Create Account</div>
            <div class="auth-form-sub">Join AQSA COLLECTION — free, fast, forever</div>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="val-summary"></div>

                <div class="fg">
                    <label class="fl">Full Name</label>
                    <div class="input-wrap">
                        <i class="fas fa-user"></i>
                        <input asp-for="FullName" class="fi" placeholder="Your full name" />
                    </div>
                    <span asp-validation-for="FullName" class="field-error"></span>
                </div>

                <div class="fg">
                    <label class="fl">Email Address</label>
                    <div class="input-wrap">
                        <i class="fas fa-envelope"></i>
                        <input asp-for="Email" class="fi" placeholder="your@email.com" />
                    </div>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="fg-row">
                    <div class="fg" style="margin-bottom:0;">
                        <label class="fl">Password</label>
                        <div class="input-wrap">
                            <i class="fas fa-lock"></i>
                            <input asp-for="Password" class="fi" id="pwdInput" placeholder="Min 6 characters" />
                        </div>
                        <div class="pwd-strength" id="pwdBars">
                            <div class="ps-bar" id="b1"></div>
                            <div class="ps-bar" id="b2"></div>
                            <div class="ps-bar" id="b3"></div>
                            <div class="ps-bar" id="b4"></div>
                        </div>
                        <div class="ps-label" id="pwdLabel">Enter a password</div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>
                    <div class="fg" style="margin-bottom:0;">
                        <label class="fl">Confirm Password</label>
                        <div class="input-wrap">
                            <i class="fas fa-lock"></i>
                            <input asp-for="ConfirmPassword" class="fi" placeholder="Repeat password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>
                </div>

                <button type="submit" class="btn-submit" style="margin-top:20px;">
                    <i class="fas fa-user-plus"></i> Create My Account
                </button>
            </form>

            <div class="auth-divider"><span>already a member?</span></div>
            <div class="login-row">
                <a asp-action="Login"><i class="fas fa-sign-in-alt"></i> Sign in to your account</a>
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="auth-panel">
            <div class="panel-content">
                <a asp-controller="Home" asp-action="Index" class="panel-logo">
                    <span class="panel-logo-dot"></span>
                    AQSA COLLECTION
                </a>
                <div class="panel-tag"><i class="fas fa-gem"></i> Join Today</div>
                <h2 class="panel-title">Shop the <em>Finest Cut.</em></h2>
                <p class="panel-sub">Create a free account and unlock a premium shopping experience curated for those who care about quality.</p>
                <div class="perks">
                    <div class="perk">
                        <div class="perk-ico"><i class="fas fa-shipping-fast"></i></div>
                        <div class="perk-text"><strong>Free Delivery</strong>On all orders over ₹999</div>
                    </div>
                    <div class="perk">
                        <div class="perk-ico"><i class="fas fa-undo"></i></div>
                        <div class="perk-text"><strong>Easy Returns</strong>30-day hassle-free returns</div>
                    </div>
                    <div class="perk">
                        <div class="perk-ico"><i class="fas fa-lock"></i></div>
                        <div class="perk-text"><strong>Secure Payments</strong>SSL encrypted checkout</div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const vs = document.querySelector('.val-summary');
        if (vs && vs.innerText.trim()) vs.style.display = 'block';

        // Password strength meter
        const pwd = document.getElementById('pwdInput');
        const bars = [document.getElementById('b1'),document.getElementById('b2'),document.getElementById('b3'),document.getElementById('b4')];
        const lbl = document.getElementById('pwdLabel');
        pwd?.addEventListener('input', function(){
            const v = this.value;
            let score = 0;
            if(v.length >= 6)  score++;
            if(v.length >= 10) score++;
            if(/[A-Z]/.test(v) && /[0-9]/.test(v)) score++;
            if(/[^A-Za-z0-9]/.test(v)) score++;
            const cls = ['','weak','medium','medium','strong'];
            const labels = ['Enter a password','Too short','Fair','Good','Strong'];
            bars.forEach((b,i) => { b.className = 'ps-bar' + (i < score ? ' ' + cls[score] : ''); });
            lbl.textContent = labels[score] || 'Strong';
            lbl.style.color = score <= 1 ? '#b3432f' : score <= 2 ? 'var(--gold)' : 'var(--green-ok)';
        });
    </script>
}
